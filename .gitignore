# Build outputs
bin/
obj/
runtime/server.exe

# Release archives produced by scripts/release-runtime.ps1. A package is built
# from a tag, so a checked-in archive could only be stale.
dist/

# The client build. dist/ is produced from console/web/ and embedded into the
# Runtime binary; only the placeholder that keeps the embed pattern valid is
# tracked, so a checked-in bundle can never drift from its source.
console/dist/*
!console/dist/.gitkeep
console/web/node_modules/

# IDE/editor state
.vs/
.vscode/
.idea/
*.user
*.suo

# OS noise
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.temp
*.stackdump
runtime/.local/
runtime/data/

# Go local artifacts
*.test
coverage.out
.gocache/

# Local private config overrides
runtime/config/*.local.json

# Credentials. The development data root is inside the repository, so a secret
# written to <root>/secrets/ during local testing must never be committable.
runtime/secrets/

# AGENTS.md is tracked: it is the repository's standing agent instructions.

# Local-only agent instructions
AGENTS.local.md

docs/roadmap/

docs/archive/
docs/pro/

.obsidian/
.gstack/
