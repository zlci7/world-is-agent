  "narrative": {
    "northStar": "Pixel Game Windows",
    "overview": "Pixel landscapes sit behind framed, translucent windows. Warm farmland accompanies Stardew Valley; a cool colony landscape accompanies RimWorld. Chinese system typography, aligned information, and compact controls keep appointments and configuration readable.\n\nThe Vue console uses the same layout and components in both themes. The loaded game determines the palette and scenery. Theme replacement is immediate; configuration progress and errors appear beside the controls.",
    "keyCharacteristics": [
      "Square frames, inset highlights, and short hard shadows.",
      "Layered background alpha with fully opaque reading text.",
      "A list-and-detail workbench that becomes a single-pane mobile view.",
      "Text and icons distinguish task states and world availability."
    ],
    "rules": [
      { "name": "The Layered Fill Rule", "body": "Apply transparency to background colors. Keep normal text and controls fully opaque; disabled controls use the implemented reduced opacity.", "section": "colors" },
      { "name": "The Loaded Game Rule", "body": "Update scenery and palette when the Runtime reports the loaded game. A radio selection alone does not change the theme. Retain the last loaded theme during a connection interruption.", "section": "elevation" }
    ],
    "dos": [
      "Do reuse the paired theme roles and the existing square frames.",
      "Do preserve aligned insets and readable Chinese system typography.",
      "Do keep world availability, task state, and configuration progress explicit in text.",
      "Do retain keyboard focus when mobile readers move between list and detail."
    ],
    "donts": [
      "Don't lower normal text opacity to create translucent windows.",
      "Don't preview a theme from an unapplied game selection.",
      "Don't add theme-transition overlays, animations, or decorative UI."
    ]
  }
