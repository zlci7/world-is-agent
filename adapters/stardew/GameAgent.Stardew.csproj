<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GameAgent.Stardew</AssemblyName>
    <RootNamespace>GameAgent.Stardew</RootNamespace>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Stardew install location. Resolution order:
         1. -p:GamePath=<dir> or the GamePath environment variable
         2. repository-relative convenience fallback: local development only.
         A machine whose install path differs from the fallback must set it explicitly. -->
    <GamePath Condition="'$(GamePath)' == ''">$(MSBuildThisFileDirectory)..\..\..\Stardew Valley</GamePath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Explicit protocol dependency point. Resolution order:
         1. -p:WIA_PROTOCOL_DIR=<dir> or the WIA_PROTOCOL_DIR environment variable
            (MSBuild reads a property name from the environment when no parameter sets it)
         2. monorepo-relative convenience fallback: local development only.
         The fallback is not a dependency. Standalone verification must pass the path explicitly. -->
    <WIA_PROTOCOL_DIR Condition="'$(WIA_PROTOCOL_DIR)' == ''">$(MSBuildThisFileDirectory)..\..\protocol</WIA_PROTOCOL_DIR>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MonoGame.Framework" HintPath="$(GamePath)\MonoGame.Framework.dll" Private="False" />
    <Reference Include="Stardew Valley" HintPath="$(GamePath)\Stardew Valley.dll" Private="False" />
    <Reference Include="StardewModdingAPI" HintPath="$(GamePath)\StardewModdingAPI.dll" Private="False" />
    <Reference Include="StardewValley.GameData" HintPath="$(GamePath)\StardewValley.GameData.dll" Private="False" />
    <Reference Include="xTile" HintPath="$(GamePath)\xTile.dll" Private="False" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.27.3" />
    <PackageReference Include="Grpc.Net.Client" Version="2.64.0" />
    <PackageReference Include="Grpc.Tools" Version="2.64.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="$(WIA_PROTOCOL_DIR)\proto\gameagent.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets\landmarks.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
</Project>
