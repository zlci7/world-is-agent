<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- RimWorld mod assembly. net472 is the framework RimWorld's mod ecosystem pins; the game
         runs it on Unity's Mono, where Grpc.Core's native C-core is the only working transport
         (Mono's BCL has no HTTP/2 implementation). -->
    <AssemblyName>WiaRimWorld</AssemblyName>
    <RootNamespace>Wia.RimWorld</RootNamespace>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Explicit protocol dependency point. Resolution order:
         1. -p:WIA_PROTOCOL_DIR=<dir> or the WIA_PROTOCOL_DIR environment variable
            (MSBuild reads a property name from the environment when no parameter sets it)
         2. monorepo-relative convenience fallback: local development only.
         The fallback is not a dependency. Standalone verification must pass the path explicitly. -->
    <WIA_PROTOCOL_DIR Condition="'$(WIA_PROTOCOL_DIR)' == ''">$(MSBuildThisFileDirectory)..\..\protocol</WIA_PROTOCOL_DIR>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies published with Ludeon's permission. The game install is not needed to
         compile, and no game binary is redistributed. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Google.Protobuf" Version="3.27.3" />
    <PackageReference Include="Grpc.Core" Version="2.46.6" />
    <PackageReference Include="Grpc.Tools" Version="2.46.6" PrivateAssets="All" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="$(WIA_PROTOCOL_DIR)\proto\gameagent.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <None Update="About\About.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
</Project>
