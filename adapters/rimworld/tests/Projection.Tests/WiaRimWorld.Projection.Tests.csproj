<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>WiaRimWorld.Projection.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.27.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="All" />
  </ItemGroup>

  <!-- Same pattern as the Stardew adapter's test projects: the sources are linked, not referenced.
       That is not a shortcut, it is the point - these files must stay free of RimWorld types so the
       projection can be exercised without the game, and linking them here fails the build the day
       one of them stops being game-free. -->
  <ItemGroup>
    <Compile Include="..\..\src\Projection\RimWorldSnapshot.cs" Link="Projection\RimWorldSnapshot.cs" />
    <Compile Include="..\..\src\Projection\ColonistProjection.cs" Link="Projection\ColonistProjection.cs" />
  </ItemGroup>
</Project>
